{
  "_doc": "Agent runner (#1252). Read at every batch; a change takes effect at the next timer tick. Kill switch: create ~/.config/openrisk-runner/disabled.",
  "repo": "opendefender/OpenRisk",
  "base": "develop",
  "milestone": null,
  "batch": { "refine": 5, "implement": 2, "fix": 2, "steward": 1 },
