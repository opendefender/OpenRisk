  "models": { "refine": "sonnet", "implement": "sonnet", "fix": "sonnet", "steward": "sonnet", "large": "opus" },
  "cli": "claude",
  "worktrees": "../OpenRisk-runner-wt",
  "usageBackoffMinutes": 60,
  "implementTools": "Read,Edit,Write,MultiEdit,Glob,Grep,Bash,TodoWrite",
  "refineTools": "Read,Glob,Grep,Bash(gh:*),Bash(git log:*),Bash(git show:*),Bash(node scripts/ready/gate.mjs:*),Bash(node scripts/refine/close.mjs:*)",
  "stewardTools": "Read,Glob,Grep,Bash"
}
