# Staging stack (docker-compose.staging.yaml, #1243).
# Copy to .env.staging (gitignored) and fill in. Use values different from dev.
#   docker compose -f docker-compose.staging.yaml --env-file .env.staging up -d --build

# Required. Generate each with: openssl rand -hex 32
STAGING_DB_PASSWORD=
STAGING_REDIS_PASSWORD=
STAGING_AUDIT_HASH_KEY=
# Never change it once MFA secrets are encrypted with it.
STAGING_MFA_ENCRYPTION_KEY=

# Optional host ports. None of them is published by the dev stack.
# STAGING_BACKEND_PORT=8082
# STAGING_FRONTEND_PORT=3001
# STAGING_DB_PORT=5433
# STAGING_REDIS_PORT=6381
# STAGING_PROMETHEUS_PORT=9090
# STAGING_CORS_ORIGINS=http://localhost:3001
