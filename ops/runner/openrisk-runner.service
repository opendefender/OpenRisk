[Unit]
Description=OpenRisk agent runner, one batch (#1252)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@RUN@
Environment=PATH=@PATH@
# Always run the latest develop: a merged change to the runner takes effect next batch.
ExecStartPre=/usr/bin/git -C @RUN@ fetch --quiet origin develop
ExecStartPre=/usr/bin/git -C @RUN@ checkout --quiet --detach origin/develop
ExecStart=/usr/bin/env node scripts/runner/runner.mjs
TimeoutStartSec=6h
Nice=10
