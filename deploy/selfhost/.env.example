# OpenRisk self-hosted configuration.
# scripts/install.sh generates a real .env from this template with strong random
# secrets. Copy to .env and edit if you prefer to set values yourself.

# --- Database ---
DB_USER=openrisk
# Any characters work. Wrap a password that has spaces, '#', '$' or quotes in
# single quotes: DB_PASSWORD='p@ss w#rd$1'.
DB_PASSWORD=change-me-strong-password
DB_NAME=openrisk

# --- Networking ---
# Public base URL of the deployment (used to build checkout return links).
APP_BASE_URL=http://localhost:8080
# Comma-separated origins allowed to call the API (the frontend origin).
CORS_ORIGINS=http://localhost:3000
# Host ports.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Where the browser reaches the API.
VITE_API_URL=http://localhost:8080/api/v1

# --- Encryption keys (32-byte, base64/hex) — generated by the installer ---
MFA_ENCRYPTION_KEY=
SCANNER_CREDENTIAL_KEY=
AUDIT_EXPORT_KEY=
# Keys the hash of addresses in the auth audit trail and the per-address
# limits (D-065). Required: the backend refuses to boot without it. Changing it
# breaks the link between audit entries from before and after the change.
AUDIT_HASH_KEY=
# Optional (D-064): signs the cookie that lets a browser which already signed
# in get past a sign-in lock. Empty = derived from AUDIT_HASH_KEY. At least 32
# characters when set; to rotate, put the old value in the PREVIOUS key.
DEVICE_COOKIE_KEY=
DEVICE_COOKIE_PREVIOUS_KEY=

# --- Deployment ---
# self_hosted: every organisation gets the complete, uncapped set (D-040).
# Leave it as is on your own install; "hosted" is for the OpenDefender SaaS.
OPENRISK_DEPLOYMENT=self_hosted

# --- Payment gateways (OPTIONAL) ---
# Leave empty to run Free + manual upgrades. No key ⇒ no fabricated payment URL.
STRIPE_SECRET_KEY=
NOTCHPAY_PUBLIC_KEY=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# --- Telemetry (OPTIONAL) ---
# Telemetry is opt-in from the app (Settings → Billing). Set to "off" here to
# hard-disable it regardless of any in-app consent.
OPENRISK_TELEMETRY=

# --- Version tag for images ---
OPENRISK_VERSION=latest
